{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TFH Docs",
  "colors": {
    "primary": "#000000",
    "dark": "#000",
    "light": "#fff"
  },
  "logo": {
    "light": "/images/tfh-logo.svg",
    "dark": "/images/tfh-logo-dark.svg"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon-dark.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Mini Apps",
          "href": "https://docs.world.org/mini-apps",
          "icon": "grid-2",
          "color": {
            "light": "#1989fb",
            "dark": "#4a90d9"
          }
        }
      ]
    },
    "tabs": [
      {
        "tab": "Home",
        "pages": ["index"]
      },
      {
        "tab": "World App",
        "pages": [
          "world-app/index",
          "world-app/bedrock",
          {
            "group": "Wallet",
            "pages": ["world-app/transactions"]
          },
          {
            "group": "Backup & Recovery",
            "pages": [
              "world-app/backup/index",
              "world-app/backup/structure-and-sync",
              "world-app/backup/flows",
              "world-app/backup/advanced"
            ]
          },
          {
            "group": "Advanced",
            "pages": ["world-app/cryptography"]
          }
        ]
      },
      {
        "tab": "Orb",
        "pages": ["orb/index"]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Developer Portal",
      "href": "https://developer.worldcoin.org"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/tfh_technology",
      "linkedin": "https://www.linkedin.com/company/tools-for-humanity-corp",
      "github": "https://github.com/toolsforhumanity"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  }
}
